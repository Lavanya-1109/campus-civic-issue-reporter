# Copy this file to .env and adjust as needed.

# Same Postgres the database/ package sets up (see database/README.md).
DATABASE_URL=postgresql+psycopg2://postgres.qvqkclogszuwbaaslnlz:sharmalavanya.._@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Used to sign JWTs -- change this to a long random value for anything
# beyond local development.
JWT_SECRET_KEY=change-this-dev-secret

# Access token lifetime, in minutes. Kept short-lived on purpose; there is
# no refresh-token flow yet (not needed for a course project demo).
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Where uploaded issue photos are saved locally. This stands in for
# Cloudinary/S3 until that decision is made -- see app/uploads/routes.py.
UPLOAD_FOLDER=uploads

FLASK_DEBUG=1
PORT=5000
