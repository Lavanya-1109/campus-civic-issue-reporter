# Copy this file to .env and adjust as needed.

# Local Docker Postgres (matches docker-compose.yml):
DATABASE_URL=postgresql+psycopg2://civic_user:civic_pass@localhost:5432/civic_issue_reporter

# Managed Postgres example (Supabase/Railway) — replace with your own:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>?sslmode=require
